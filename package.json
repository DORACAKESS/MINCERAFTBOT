{
  "name": "minecraft-bot-dashboard",
  "version": "1.0.0",
  "description": "Minecraft Mineflayer bot controlled from a real-time web dashboard (Express + Socket.io + Tailwind CSS)",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/watch.js",
    "start:plain": "node server.js",
    "build:viewer": "node scripts/patch-viewer.js",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o public/css/tailwind.css --minify"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "dashboard",
    "express",
    "socket.io"
  ],
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "@tabler/icons": "3.46.0",
    "dotenv": "17.4.2",
    "express": "4.21.2",
    "mineflayer": "4.37.1",
    "prismarine-schematic": "1.3.0",
    "prismarine-viewer": "1.33.0",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
